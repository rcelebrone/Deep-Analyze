{
  "name": "depcheck",
  "version": "0.1.0",
  "description": "Dependency checkup CLI: vulnerabilities, outdated majors, and minor updates for a git repository",
  "type": "module",
  "bin": {
    "depcheck": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.3.0",
    "ora": "^8.1.0",
    "p-limit": "^6.1.0",
    "semver": "^7.6.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
